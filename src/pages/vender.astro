---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Features from '../components/Features.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base
  title="Vender tu propiedad con precio respaldado | Activa Corredores"
  description="Vende tu casa o departamento en La Florida, Macul, Peñalolén o La Reina con Valorización 360°, difusión profesional y un responsable hasta la escritura. Comisión 2%."
  current="/vender"
>
  <PageHero
    eyebrow="Vender con Activa"
    title="Vende con precio respaldado,"
    accent="no con intuición."
    lead="Te acompañamos desde la primera valorización hasta la firma de la escritura, con un responsable a cargo y reportes cada semana."
  >
    <a href="/contacto?op=vender" class="btn btn--primary">Valorizar mi propiedad</a>
    <a href="/sistema" class="link">Ver el Sistema Activa</a>
  </PageHero>

  <section class="section--white">
    <div class="wrap section stack gap-48">
      <SectionHead eyebrow="Qué incluye" title="Todo lo que necesitas" accent="para vender bien." />
      <Features
        items={[
          { title: 'Valorización 360°', text: 'Tres precios posibles basados en ventas reales de tu barrio y el líquido que te quedaría en cada escenario.' },
          { title: 'Fotografía y video', text: 'Imágenes profesionales que muestran tu propiedad como es, sin exagerar.' },
          { title: 'Publicación y campañas', text: 'Presencia en los principales portales y campañas pagadas dirigidas a compradores de tu sector.' },
          { title: 'Filtro de compradores', text: 'Revisamos financiamiento y capacidad de compra antes de agendar cada visita.' },
          { title: 'Negociación', text: 'Te presentamos cada oferta con nuestra recomendación y negociamos en tu nombre.' },
          { title: 'Promesa y escritura', text: 'Preparamos la promesa de compraventa y coordinamos notaría y banco hasta la entrega.' },
        ]}
      />
    </div>
  </section>

  <section class="wrap section stack gap-48">
    <SectionHead eyebrow="El camino" title="Del primer precio" accent="a la escritura." />
    <Steps
      items={[
        { name: 'Valorización', desc: 'Defines tu precio con datos' },
        { name: 'Preparación', desc: 'Fotos, video y documentos' },
        { name: 'Publicación', desc: 'Portales y campañas' },
        { name: 'Ofertas', desc: 'Visitas filtradas y negociación' },
        { name: 'Promesa', desc: 'Se firma el compromiso' },
        { name: 'Escritura', desc: 'Firma, pago y entrega' },
      ]}
    />
  </section>

  <section class="section--white">
    <div class="wrap section stack gap-48">
      <SectionHead eyebrow="Preguntas frecuentes" title="Lo que" accent="más nos preguntan." />
      <Faq
        items={[
          { q: '¿Cuánto cobran por vender?', a: 'La comisión es de 2% sobre el precio de venta, sin IVA.' },
          { q: '¿Necesito firmar exclusividad?', a: 'Sí. Trabajamos con una orden de venta exclusiva por 120 días, el tiempo que necesita el Sistema Activa para preparar, difundir y negociar tu propiedad con un solo responsable.' },
          { q: '¿Cuánto demora en venderse?', a: 'Depende del precio, la comuna y el tipo de propiedad. En la Valorización 360° te damos una estimación para cada uno de los tres escenarios de precio.' },
          { q: '¿Qué documentos necesito?', a: 'Los habituales son el certificado de dominio vigente, el de hipotecas y gravámenes, el avalúo fiscal y los planos o recepción final. Te ayudamos a reunirlos durante la preparación.' },
          { q: '¿Qué pasa si tengo un crédito hipotecario vigente?', a: 'Se puede vender igual. Coordinamos con tu banco el alzamiento de la hipoteca como parte del cierre.' },
        ]}
      />
    </div>
  </section>

  <CtaBand
    title="¿Cuánto vale"
    accent="tu propiedad hoy?"
    text="Pide tu Valorización 360° sin costo y decide con información."
    ctaLabel="Solicitar valorización"
    ctaHref="/contacto?op=vender"
  />
</Base>
