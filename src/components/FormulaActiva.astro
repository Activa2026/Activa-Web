---
// Ecuación de la Fórmula Activa en formato "receta" (ingredientes, nunca fuentes ni pesos).
// Versión vertical: cada ingrediente en su línea, una regla dorada y el resultado.
interface Props {
  /** "light" sobre arena/blanco, "dark" sobre azul o tinta. */
  tone?: 'light' | 'dark';
  /** Muestra el nombre "Fórmula Activa" arriba de la ecuación. */
  label?: boolean;
}
const { tone = 'light', label = true } = Astro.props;

const ingredientes = [
  { texto: 'Ventas reales inscritas en el CBR', color: 'blue' },
  { texto: 'Modelos de tasación del mercado', color: 'olive' },
  { texto: 'Un corredor que conoce tu barrio', color: 'gold' },
];
---

<figure
  class:list={['formula', `formula--${tone}`]}
  aria-label="Fórmula Activa: ventas reales inscritas en el CBR, más modelos de tasación del mercado, más un corredor que conoce tu barrio, da tus tres precios"
>
  {label && <figcaption class="formula__label">Fórmula Activa</figcaption>}
  <ol class="formula__lista" aria-hidden="true">
    {
      ingredientes.map((ing, i) => (
        <li>
          <span class="formula__op">{i > 0 ? '+' : ''}</span>
          <span class:list={['formula__dot', `formula__dot--${ing.color}`]} />
          <span class="formula__texto">{ing.texto}</span>
        </li>
      ))
    }
  </ol>
  <p class="formula__resultado" aria-hidden="true">
    <span class="formula__op">=</span>
    <span class="formula__res">Tus 3 precios</span>
  </p>
</figure>

<style>
  .formula {
    margin: 0;
    max-width: 420px;
  }
  .formula__label {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--olive-ink);
  }
  .formula__lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .formula__lista li,
  .formula__resultado {
    display: grid;
    grid-template-columns: 22px 12px 1fr;
    align-items: center;
    column-gap: 12px;
  }
  .formula__lista li {
    padding: 9px 0;
    font-size: 16px;
    color: var(--ink);
  }
  .formula__op {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1;
    color: var(--gold-deep);
    text-align: center;
  }
  .formula__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .formula__dot--blue {
    background: var(--blue);
  }
  .formula__dot--olive {
    background: var(--olive);
  }
  .formula__dot--gold {
    background: var(--gold);
  }
  .formula__resultado {
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--gold);
  }
  .formula__res {
    grid-column: 2 / 4;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.2;
    color: var(--olive);
  }

  /* Sobre fondo oscuro */
  .formula--dark .formula__label {
    color: var(--gold-ink);
  }
  .formula--dark .formula__lista li {
    color: var(--white);
  }
  .formula--dark .formula__op {
    color: var(--gold);
  }
  .formula--dark .formula__res {
    color: var(--gold);
  }
</style>
