---
// Título de marca: primera frase normal, segunda en cursiva (oliva, o dorado sobre fondo oscuro).
interface Props {
  as?: 'h1' | 'h2' | 'h3';
  text: string;
  accent?: string;
  size?: 'display' | 'xl' | 'lg' | 'md' | 'cta';
  class?: string;
}
const { as: Tag = 'h2', text, accent, size = 'md', class: className } = Astro.props;
---

<Tag class:list={['title', `title--${size}`, className]}>{text}{accent && ' '}{accent && <em>{accent}</em>}</Tag>
