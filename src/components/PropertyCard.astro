---
import { Picture } from 'astro:assets';
import {
  type Propiedad,
  formatPrecio,
  superficiePrincipal,
  cartel,
  cerrada,
  TIPO_LABEL,
  OPERACION_LABEL,
} from '../lib/propiedades';

interface Props {
  propiedad: Propiedad;
}
const { propiedad } = Astro.props;
const d = propiedad.data;
const sello = cartel(d.estado);
const datos = [
  superficiePrincipal(d),
  d.dormitorios != null ? `${d.dormitorios} dorm.` : null,
  d.banos != null ? `${d.banos} baño${d.banos === 1 ? '' : 's'}` : null,
].filter(Boolean);
---

<a
  href={`/propiedades/${propiedad.id}`}
  class:list={['pcard', { 'pcard--cerrada': cerrada(d.estado) }]}
  data-operacion={d.operacion}
  data-comuna={d.comuna}
  data-tipo={d.tipo}
>
  <div class="pcard__media">
    <Picture
      src={d.fotos[0]}
      alt=""
      formats={['avif', 'webp']}
      widths={[360, 560, 800]}
      sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px"
      loading="lazy"
      decoding="async"
    />
    {!cerrada(d.estado) && <span class="pcard__op">{OPERACION_LABEL[d.operacion]}</span>}
    {sello && <span class:list={['pcard__sello', `pcard__sello--${d.estado}`]}>{sello}</span>}
  </div>
  <div class="pcard__body">
    <p class="pcard__lugar">{TIPO_LABEL[d.tipo]} · {d.comuna}{d.sector && `, ${d.sector}`}</p>
    <h3 class="pcard__titulo">{d.titulo}</h3>
    <p class="pcard__precio">
      {formatPrecio(d.precio)}{d.operacion === 'arriendo' && <span> / mes</span>}
    </p>
    {datos.length > 0 && <p class="pcard__datos">{datos.join(' · ')}</p>}
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .pcard:hover {
    color: var(--ink);
    box-shadow: 0 18px 32px -20px rgb(30 51 80 / 0.35);
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--track);
  }
  .pcard__media :global(picture),
  .pcard__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__media :global(img) {
    transition: transform 0.6s var(--ease);
  }
  .pcard:hover .pcard__media :global(img) {
    transform: scale(1.03);
  }
  .pcard--cerrada .pcard__media :global(img) {
    filter: saturate(0.6);
  }
  .pcard__op {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--white);
    color: var(--blue);
    font-size: 13px;
    font-weight: 600;
  }
  /* Cartel en diagonal */
  .pcard__sello {
    position: absolute;
    top: 26px;
    right: -46px;
    width: 180px;
    padding: 6px 0;
    transform: rotate(35deg);
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 4px 10px -4px rgb(0 0 0 / 0.3);
  }
  .pcard__sello--vendida,
  .pcard__sello--arrendada {
    background: var(--blue);
    color: var(--white);
  }
  .pcard__sello--reservada {
    background: var(--gold);
    color: var(--ink);
  }
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 24px;
  }
  .pcard__lugar {
    font-size: 14px;
    color: var(--text-3);
  }
  .pcard__titulo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.25;
  }
  .pcard__precio {
    margin-top: 4px;
    font-family: var(--font-serif);
    font-size: 24px;
    color: var(--blue);
  }
  .pcard__precio span {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--text-3);
  }
  .pcard__datos {
    font-size: 14px;
    color: var(--text-2);
  }
</style>
