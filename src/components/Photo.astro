---
// Foto optimizada (AVIF/WebP, tamaños responsivos) si existe el archivo en
// src/assets/images/<name>.(jpg|jpeg|png|webp|avif); si no, un bloque de color
// de la paleta con el texto del marcador. Ver IMAGENES.md.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  placeholder: string;
  tone?: 1 | 2 | 3 | 4;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  name,
  alt,
  placeholder,
  tone = 1,
  widths = [400, 800, 1200],
  sizes = '(max-width: 640px) 100vw, 50vw',
  priority = false,
  class: className,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{jpg,jpeg,png,webp,avif}',
);
const match = Object.keys(files).find((path) => path.replace(/^.*\/|\.[^.]+$/g, '') === name);
const image = match ? (await files[match]()).default : undefined;
const usableWidths = image ? widths.filter((w) => w <= image.width) : [];
if (image && usableWidths.length === 0) usableWidths.push(image.width);
---

{
  image ? (
    <div class:list={['photo', className]}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={usableWidths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    </div>
  ) : (
    <div class:list={['photo', 'photo--placeholder', `photo--tone-${tone}`, className]}>
      <span>[Foto: {placeholder}]</span>
    </div>
  )
}

<style>
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo--placeholder {
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }
  .photo--placeholder span {
    font-size: 13px;
    color: var(--white);
  }
  .photo--tone-1 { background: var(--ph-1); }
  .photo--tone-2 { background: var(--ph-2); }
  .photo--tone-3 { background: var(--ph-3); }
  .photo--tone-4 { background: var(--ph-4); }
</style>
